# Needed for real runs. Create an agent token at https://looot.ai/settings
LOOOT_TOKEN=
# Most one run may spend, in dollars. Default 1
SIGNALS_CAP_USD=1
# Optional. The webhook receives the signals of the last run as JSON. https only.
SIGNALS_WEBHOOK_URL=
# Optional. When set, each webhook carries X-Signals-Signature: sha256=<hmac of the body>
SIGNALS_WEBHOOK_SECRET=
# Optional paths. Defaults: triggers.yaml (else triggers.example.yaml) and data/state.json
SIGNALS_TRIGGERS=
SIGNALS_STATE=
