# Admin password for every page and API route except /login, /api/auth/* and /api/health. 12 characters or more.
# Required outside the demo. Without it the admin pages stay closed and /login shows a setup page.
SIGNALS_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# SIGNALS_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# SIGNALS_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# SIGNALS_COOKIE_SECURE=
# Token for real runs. Create it in looot Settings, Agent tokens. The CLI reads the shell, not this file.
LOOOT_TOKEN=
# looot API base URL used to read live prices. Default https://api.looot.ai
# LOOOT_API_URL=
# Most one web app run may spend, in dollars. Default 1. The CLI uses --cap.
SIGNALS_CAP_USD=1
# Optional. The webhook receives the signals of the last run as JSON. https only, on a public host. Private, loopback and link-local addresses are refused.
SIGNALS_WEBHOOK_URL=
# Optional. When set, each webhook carries X-Signals-Signature: sha256=<hmac of the body>
SIGNALS_WEBHOOK_SECRET=
# Optional trigger file for the web app. Default triggers.yaml, else triggers.example.yaml
SIGNALS_TRIGGERS=
# Optional state file for the web app. Default data/state.json
SIGNALS_STATE=
